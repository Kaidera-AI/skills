{
  "schema_version": 2,
  "evaluator_profile": "kaidera-static-routing-v2",
  "skill": "open-code-review",
  "skill_path": "skills/development/open-code-review.SKILL.md",
  "contract": {
    "expected_trust_tier": "unvetted",
    "expected_declared_capabilities": [
      "tool:file_read",
      "tool:code_interpreter"
    ],
    "capability_ceiling": [
      "tool:file_read",
      "tool:code_interpreter"
    ],
    "no_write": true,
    "no_network": true
  },
  "routing": {
    "route_when_any": [
      ["review", "staged diff"],
      ["review", "commit"],
      ["review", "pull request patch"]
    ],
    "manual_only_when_any": [
      ["implement", "fixes"]
    ]
  },
  "cases": [
    {
