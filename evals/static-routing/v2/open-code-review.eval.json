      "kind": "positive",
      "prompt": "Review the staged diff for concrete correctness and security defects; return findings only.",
      "expected": {
        "outcome": "route",
        "route": "open-code-review",
        "candidates": ["open-code-review"],
        "reason": "single-match"
      }
    },
    {
      "id": "bounded-commit-review",
      "kind": "positive",
      "prompt": "Review the commit note about implementation prefixes in the parser; return findings only.",
      "expected": {
        "outcome": "route",
        "route": "open-code-review",
        "candidates": ["open-code-review"],
        "reason": "single-match"
      }
    },
    {
      "id": "bounded-pull-request-review",
      "kind": "positive",
      "prompt": "Review the pull request patch for concrete defects and return findings only.",
      "expected": {
        "outcome": "route",
        "route": "open-code-review",
        "candidates": ["open-code-review"],
        "reason": "single-match"
      }
    },
    {
      "id": "whole-repository-audit",
      "kind": "negative",
      "prompt": "Audit the whole repository architecture and dead code, not a bounded change.",
      "expected": {
        "outcome": "abstain",
        "route": null,
        "candidates": [],
        "reason": "no-match"
      }
    },
    {
      "id": "substring-non-match",
      "kind": "negative",
      "prompt": "Please preview our commitment schedule for the next quarter.",
      "expected": {
        "outcome": "abstain",
        "route": null,
        "candidates": [],
        "reason": "no-match"
      }
    },
    {
      "id": "review-assumption-collision",
      "kind": "collision",
      "prompt": "Review the staged diff and validate the billing assumption behind the changed default before release.",
      "expected": {
        "outcome": "manual-only",
        "route": null,
        "candidates": ["assumption-validation", "open-code-review"],
        "reason": "multi-skill-collision"
      }
    },
    {
      "id": "review-and-mutate-boundary",
      "kind": "boundary",
      "prompt": "Review the commit, implement the fixes, and push them.",
      "expected": {
        "outcome": "manual-only",
        "route": null,
